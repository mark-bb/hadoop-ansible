<configuration>
  <property><name>hbase.rootdir</name><value>hdfs://nameservice1/user/hadoop/hbase</value></property>
  <property><name>hbase.cluster.distributed</name><value>true</value></property>
  <property><name>hbase.zookeeper.quorum</name><value>astra181-scylla-01.internal:2281,astra181-scylla-02.internal:2281,astra181-scylla-03.internal:2281</value></property>
  <property><name>hbase.superuser</name><value>hadoop</value></property>
  
  <property><name>hbase.ssl.enabled</name><value>true</value></property>
  
  <property><name>hbase.security.authentication</name><value>kerberos</value></property>
  <property><name>hbase.master.keytab.file</name><value>/etc/security/keytabs/hbase.keytab</value></property>
  <property><name>hbase.master.kerberos.principal</name><value>hbase/_HOST@DOMAIN.COM</value></property>
  <property><name>hbase.regionserver.keytab.file</name><value>/etc/security/keytabs/hbase.keytab</value></property>
  <property><name>hbase.regionserver.kerberos.principal</name><value>hbase/_HOST@DOMAIN.COM</value></property>
  
  <property><name>hbase.security.authentication.ui</name><value>kerberos</value></property>
  <property><name>hbase.security.authentication.spnego.kerberos.principal</name><value>HTTP/_HOST@DOMAIN.COM</value></property>
  <property><name>hbase.security.authentication.spnego.kerberos.keytab</name><value>/etc/security/keytabs/HTTP.keytab</value></property>
  <property><name>hbase.security.authentication.spnego.kerberos.name.rules</name><value></value>
    <description>Optional, Hadoop-style 'auth_to_local' rules which will be parsed and used in the handling of Kerberos principals</description>
  </property>
  <property><name>hbase.security.authentication.spnego.admin.users</name><value>hadoop</value></property>
  <property><name>hbase.security.authentication.spnego.admin.groups</name><value>hadoop</value></property>
</configuration>
