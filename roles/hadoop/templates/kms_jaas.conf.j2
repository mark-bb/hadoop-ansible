ZKSignerSecretProviderClient {
       com.sun.security.auth.module.Krb5LoginModule required
       doNotPrompt=true
       useKeyTab=true
       storeKey=true
       useTicketCache=false
       keyTab="{{ keytabs_path ~ '/kms.keytab' }}"
       principal="{{ 'kms/' ~ inventory_hostname ~ '@' ~ kerberos_realm }}"
;};
