<configuration>

{% if with_zookeeper | bool %}
  <property><name>hadoop.zk.address</name><value>{{ ha_zookeeper_quorum }}</value></property>
  <property><name>yarn.acl.enable</name><value>true</value></property>
  <property><name>yarn.resourcemanager.cluster-id</name><value>rmservice1</value></property>
  <property><name>yarn.resourcemanager.ha.enabled</name><value>true</value></property>
  <property><name>yarn.resourcemanager.ha.rm-ids</name><value>{{ groups[yarn_group] | map('regex_replace', '[.].*', '') | join(',') }}</value></property>
  {{ groups[yarn_group] | map('regex_replace', '^([^.]+)(.*)$', '<property><name>yarn.resourcemanager.hostname.\\1</name><value>\\1\\2</value></property>') | join('\n  ') }}
{% if with_ssl | bool %}
  {{ groups[yarn_group] | map('regex_replace', '^([^.]+)(.*)$', '<property><name>yarn.resourcemanager.webapp.https.address.\\1</name><value>\\1\\2:8090</value></property>') | join('\n  ') }}
{% else %}
  {{ groups[yarn_group] | map('regex_replace', '^([^.]+)(.*)$', '<property><name>yarn.resourcemanager.webapp.address.\\1</name><value>\\1\\2:8088</value></property>') | join('\n  ') }}
{% endif %}
{% else %}
  <property><name>yarn.acl.enable</name><value>false</value></property>
  <property><name>yarn.resourcemanager.hostname</name><value>{{ yarn_rm_hostname }}</value></property>
{% endif %}

  <property><name>yarn.resourcemanager.bind-host</name><value>0.0.0.0</value></property>
  <property><name>yarn.webapp.ui2.enable</name><value>true</value></property>

  <property><name>yarn.resourcemanager.system-metrics-publisher.enabled</name><value>true</value></property>
  <property><name>yarn.system-metrics-publisher.enabled</name><value>true</value></property>
  
  <property><name>yarn.resourcemanager.recovery.enabled</name><value>true</value></property>
{% if with_zookeeper | bool %}
  <property><name>yarn.resourcemanager.zk-state-store.parent-path</name><value>/rmstore</value></property>
  <property><name>yarn.resourcemanager.store.class</name><value>org.apache.hadoop.yarn.server.resourcemanager.recovery.ZKRMStateStore</value></property>
{% if with_kerberos | bool %}
  <property><name>hadoop.zk.acl</name><value>sasl:RM:rwcda</value></property>
{% endif %}
{% else %}
  <property><name>yarn.resourcemanager.fs.state-store.uri</name><value>{{ yarn_rmstore_dir_hadoop }}</value></property>
  <property><name>yarn.resourcemanager.store.class</name><value>org.apache.hadoop.yarn.server.resourcemanager.recovery.FileSystemRMStateStore</value></property>
{% endif %}
  <property><name>yarn.resourcemanager.application-https.policy</name><value>{{ with_ssl | bool | ternary('STRICT', 'NONE') }}</value></property>

  <property><name>yarn.timeline-service.enabled</name><value>true</value></property>
  <property><name>yarn.timeline-service.http-cross-origin.enabled</name><value>true</value></property>
  <property><name>yarn.timeline-service.generic-application-history.enabled</name><value>true</value></property>
  <property><name>yarn.timeline-service.hostname</name><value>{{ yarn_timeline_hostname }}</value></property>
  <property><name>yarn.timeline-service.bind-host</name><value>0.0.0.0</value></property>
  <property><name>yarn.timeline-service.address</name><value>${yarn.timeline-service.hostname}:10200</value></property>
  <property><name>yarn.timeline-service.webapp.address</name><value>${yarn.timeline-service.hostname}:8188</value></property>
  <property><name>yarn.timeline-service.webapp.https.address</name><value>${yarn.timeline-service.hostname}:8190</value></property>
  <property><name>yarn.timeline-service.ttl-ms</name><value>7776000000</value></property>
  <!-- <property><name>yarn.timeline-service.leveldb-timeline-store.path</name><value>${hadoop.tmp.dir}/yarn/timeline</value></property> -->

{% if not (yarn_with_tls_v20 | bool) and  not (yarn_with_tls_v15 | bool) %}
  <property><name>yarn.timeline-service.version</name><value>1.0f</value></property>
  <property><name>yarn.timeline-service.store-class</name><value>org.apache.hadoop.yarn.server.timeline.LeveldbTimelineStore</value></property>
{% else %} 
  <property><name>yarn.timeline-service.versions</name><value>{{ yarn_tls_versions | selectattr('when') | map(attribute='ver') | join(',') }}</value></property>
{% endif %} 

{% if yarn_with_tls_v20 | bool %}
  <property><name>yarn.rm.system-metrics-publisher.emit-container-events</name><value>true</value></property>
  <property><name>yarn.nodemanager.emit-container-events</name><value>true</value></property>
  <property><name>yarn.timeline-service.reader.webapp.address</name><value>${yarn.timeline-service.hostname}:8198</value></property>
  <property><name>yarn.timeline-service.reader.webapp.https.address</name><value>${yarn.timeline-service.hostname}:8199</value></property>
  <!--
  <property><name>yarn.log.server.web-service.url</name><value>{{ with_ssl | bool | ternary('https', 'http') }}://${yarn.timeline-service.hostname}:{{ with_ssl | bool | ternary('8190', '8188') }}/ws/v2/applicationlog</value></property>
  -->
  <property><name>yarn.log.server.web-service.url</name><value>${yarn.timeline-service.hostname}:{{ with_ssl | bool | ternary('8199', '8198') }}/ws/v2/applicationlog</value></property>
{% endif %} 

{% if yarn_with_tls_v15 | bool %}
  <property><name>yarn.timeline-service.entity-group-fs-store.active-dir</name><value>{{ yarn_timeline_active_dir }}</value></property>
  <property><name>yarn.timeline-service.entity-group-fs-store.done-dir</name><value>{{ yarn_timeline_done_dir }}</value></property>
  <property><name>yarn.timeline-service.entity-group-fs-store.summary-store</name><value>org.apache.hadoop.yarn.server.timeline.RollingLevelDBTimelineStore</value></property>
  <property><name>yarn.timeline-service.entity-group-fs-store.group-id-plugin-classes</name><value>org.apache.tez.dag.history.logging.ats.TimelineCachePluginImpl</value></property>
  <property><name>yarn.timeline-service.store-class</name><value>org.apache.hadoop.yarn.server.timeline.EntityGroupFSTimelineStore</value></property>
{% endif %} 

  <property><name>yarn.log-aggregation-enable</name><value>true</value></property>
  <property><name>yarn.http.policy</name><value>{{ with_ssl | bool | ternary('HTTPS_ONLY', 'HTTP') }}</value></property>
  <property><name>yarn.log.server.url</name><value>{{ yarn_log_server_url }}</value></property>

  <property><name>yarn.scheduler.capacity.maximum-am-resource-percent</name><value>1.0</value></property>
  <property><name>yarn.scheduler.maximum-allocation-vcores</name><value>16</value></property>
  <property><name>yarn.scheduler.maximum-allocation-mb</name><value>49152</value></property>
  <property><name>yarn.scheduler.capacity.root.default.maximum-am-resource-percent</name><value>1.0</value></property>
  <property><name>yarn.scheduler.capacity.root.default.maximum-allocation-vcores</name><value>16</value></property>
  <property><name>yarn.scheduler.capacity.root.default.maximum-allocation-mb</name><value>49152</value></property>

  <property><name>yarn.nodemanager.resource.memory-mb</name><value>49152</value></property>
  <property><name>yarn.nodemanager.resource.cpu-vcores</name><value>16</value></property>
  <property><name>yarn.nodemanager.aux-services</name><value>{{ 'mapreduce_shuffle' ~ ( yarn_with_tls_v20 | bool | ternary(',timeline_collector', '') ) }}</value></property>
  <property><name>yarn.nodemanager.vmem-check-enabled</name><value>false</value></property>
  <property><name>yarn.nodemanager.delete.debug-delay-sec</name><value>600</value></property>
  
<!--
  <property><name>yarn.scheduler.minimum-allocation-mb</name><value>128</value></property>
-->
  
{% if with_kerberos | bool %}
  <property><name>yarn.resourcemanager.principal</name><value>{{ yarn_rm_kerberos_principal }}</value></property>
  <property><name>yarn.resourcemanager.keytab</name><value>{{ yarn_rm_kerberos_keytab }}</value></property>
  <property><name>yarn.resourcemanager.webapp.spnego-principal</name><value>{{ yarn_http_kerberos_principal }}</value></property>
  <property><name>yarn.resourcemanager.webapp.spnego-keytab-file</name><value>{{ yarn_http_kerberos_keytab }}</value></property>
  
  <property><name>yarn.nodemanager.principal</name><value>{{ yarn_nm_kerberos_principal }}</value></property>
  <property><name>yarn.nodemanager.keytab</name><value>{{ yarn_nm_kerberos_keytab }}</value></property>
  <property><name>yarn.nodemanager.webapp.spnego-principal</name><value>{{ yarn_http_kerberos_principal }}</value></property>
  <property><name>yarn.nodemanager.webapp.spnego-keytab-file</name><value>{{ yarn_http_kerberos_keytab }}</value></property>
  
  <property><name>yarn.timeline-service.http-cross-origin.enabled</name><value>true</value></property>
  <property><name>yarn.timeline-service.http-authentication.type</name><value>kerberos</value></property>
  <property><name>yarn.timeline-service.http-authentication.kerberos.principal</name><value>{{ yarn_http_kerberos_principal }}</value></property>
  <property><name>yarn.timeline-service.http-authentication.kerberos.keytab</name><value>{{ yarn_http_kerberos_keytab }}</value></property>
  <property><name>yarn.timeline-service.principal</name><value>{{ yarn_timeline_kerberos_principal }}</value></property>
  <property><name>yarn.timeline-service.keytab</name><value>{{ yarn_timeline_kerberos_keytab }}</value></property>
{% endif %}

{% if yarn_with_tls_v20 | bool %}
  <property><name>yarn.timeline-service.hbase.configuration.file</name><value>{{ 'file:' ~ hbase_conf_dir ~ '/hbase-site.xml' }}</value></property>
  <property><name>yarn.timeline-service.hbase.coprocessor.jar.hdfs.location</name><value>{{ yarn_timeline_hbase_coprocessor_jar_location }}</value></property>
  <property><name>yarn.timeline-service.schema-creator.class</name><value>org.apache.hadoop.yarn.server.timelineservice.storage.HBaseTimelineSchemaCreator</value></property>
  <property><name>yarn.nodemanager.aux-services.timeline_collector.class</name><value>org.apache.hadoop.yarn.server.timelineservice.collector.PerNodeTimelineCollectorsAuxService</value></property>
{% endif %}

</configuration>

